---
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
---

<aside class="section-roller" aria-label={c.sectionNav} hidden>
  <p class="view-mark" data-mark aria-hidden="true"></p>
  <nav class="view-box">
    <p class="view-kicker">{c.sectionNav}</p>
    <div class="view-list" data-track></div>
  </nav>
</aside>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const flow = document.querySelector('.page-flow');
  const roller = document.querySelector('.section-roller');
  const track = roller?.querySelector('[data-track]');
  const mark = roller?.querySelector('[data-mark]');

  if (flow instanceof HTMLElement && roller instanceof HTMLElement && track instanceof HTMLElement) {
    const panes = () =>
      [...flow.querySelectorAll('[data-section]')].filter(
        (node): node is HTMLElement => node instanceof HTMLElement,
      );

    const darkPane = (el: HTMLElement) =>
      el.classList.contains('hero') ||
      el.classList.contains('band-navy') ||
      el.classList.contains('site-footer');

    let index = 0;
    let locked = false;
    let acc = 0;
    let touchY = 0;
    let touchX = 0;

    const paint = () => {
      const list = panes();
      const pane = list[index];
      track.querySelectorAll('.roller-item').forEach((btn, i) => {
        btn.classList.toggle('is-current', i === index);
        btn.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      roller.classList.toggle('is-on-dark', darkPane(pane ?? list[0]));
      if (mark instanceof HTMLElement) {
        mark.textContent = pane?.dataset.section ?? '';
      }
    };

    const currentIndex = () => {
      const list = panes();
      const mid = flow.scrollTop + flow.clientHeight * 0.45;
      let best = 0;
      let dist = Infinity;
      list.forEach((el, i) => {
        const d = Math.abs(el.offsetTop + el.clientHeight * 0.45 - mid);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };

    const go = (next: number) => {
      const list = panes();
      if (!list.length) return;
      const clamped = Math.max(0, Math.min(list.length - 1, next));
      if (clamped === index && Math.abs(list[clamped].offsetTop - flow.scrollTop) < 4) return;
      index = clamped;
      const el = list[index];
      el.scrollTop = 0;
      flow.scrollTo({ top: el.offsetTop, behavior: reduced ? 'auto' : 'smooth' });
      paint();
    };

    const overflowing = (el: HTMLElement, dir: number) => {
      if (el.scrollHeight <= el.clientHeight + 8) return false;
      if (dir > 0) return el.scrollTop + el.clientHeight < el.scrollHeight - 8;
      return el.scrollTop > 8;
    };

    const build = () => {
      const list = panes();
      if (!list.length) return;
      track.replaceChildren();
      list.forEach((el, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'roller-item';
        btn.textContent = el.dataset.section || `Section ${i + 1}`;
        btn.addEventListener('click', () => go(i));
        track.append(btn);
      });
      roller.hidden = false;
      index = currentIndex();
      paint();
    };

    build();

    flow.addEventListener(
      'scroll',
      () => {
        const next = currentIndex();
        if (next !== index) {
          index = next;
          paint();
        }
      },
      { passive: true },
    );

    if (!reduced) {
      flow.addEventListener(
        'wheel',
        (event) => {
          if (event.ctrlKey) return;
          if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
          const target = event.target;
          if (target instanceof Element && target.closest('input, textarea, select')) return;
          if (
            target instanceof Element &&
            target.closest('.flow-frame') &&
            Math.abs(event.deltaX) >= Math.abs(event.deltaY)
          ) {
            return;
          }
          const i = currentIndex();
          const pane = panes()[i];
          if (!pane) return;
          if (overflowing(pane, event.deltaY)) {
            event.preventDefault();
            pane.scrollTop += event.deltaY;
            return;
          }
          event.preventDefault();
          if (locked) return;
          acc += event.deltaY;
          if (Math.abs(acc) < 28) return;
          const dir = acc > 0 ? 1 : -1;
          acc = 0;
          locked = true;
          go(i + dir);
          window.setTimeout(() => {
            locked = false;
          }, 720);
        },
        { passive: false },
      );

      flow.addEventListener(
        'touchstart',
        (event) => {
          touchY = event.touches[0]?.clientY ?? 0;
          touchX = event.touches[0]?.clientX ?? 0;
        },
        { passive: true },
      );

      flow.addEventListener(
        'touchend',
        (event) => {
          const touch = event.changedTouches[0];
          if (!touch) return;
          const dy = touchY - touch.clientY;
          const dx = touchX - touch.clientX;
          if (Math.abs(dy) < 40 || Math.abs(dy) < Math.abs(dx) * 1.1) return;
          const target = event.target;
          if (target instanceof Element && target.closest('input, textarea, select')) return;
          const i = currentIndex();
          const pane = panes()[i];
          if (pane && overflowing(pane, dy)) return;
          if (locked) return;
          locked = true;
          go(i + (dy > 0 ? 1 : -1));
          window.setTimeout(() => {
            locked = false;
          }, 720);
        },
        { passive: true },
      );
    }

    window.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement) {
        const tag = target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable) {
          return;
        }
      }
      const i = currentIndex();
      const pane = panes()[i];
      if (event.key === 'PageDown' || event.key === 'ArrowDown' || event.key === ' ') {
        if (pane && overflowing(pane, 1) && event.key !== 'PageDown') return;
        event.preventDefault();
        go(i + 1);
      } else if (event.key === 'PageUp' || event.key === 'ArrowUp') {
        if (pane && overflowing(pane, -1) && event.key === 'ArrowUp') return;
        event.preventDefault();
        go(i - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        go(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        go(panes().length - 1);
      }
    });
  }
</script>
