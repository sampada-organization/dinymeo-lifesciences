---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 40 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 40 40"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'heart' && (
      <>
        <path d="M20 33s-11.5-7.2-11.5-15.2A7.4 7.4 0 0 1 20 13a7.4 7.4 0 0 1 11.5 4.8C31.5 25.8 20 33 20 33z"></path>
        <path class="accent" stroke="none" d="M20 16.2c1.2-2.2 4.6-2.4 5.8.1.7 1.5.2 3.1-1 4.2L20 24.8l-4.8-4.3c-1.2-1.1-1.7-2.7-1-4.2 1.2-2.5 4.6-2.3 5.8-.1z"></path>
        <path d="M12 22h4l2-3 3 6 2-3h5" stroke-width="1.3"></path>
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M20 5.5 8 10.2v9.4c0 7.6 5 12.8 12 14.4 7-1.6 12-6.8 12-14.4v-9.4L20 5.5z"></path>
        <path d="M14.5 20.2 18.2 24l7.3-8.2" stroke-width="1.9"></path>
        <circle class="accent" cx="20" cy="13.2" r="1.6" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'care' && (
      <>
        <circle cx="15.2" cy="15" r="4.2"></circle>
        <circle cx="24.8" cy="16.2" r="3.4"></circle>
        <path d="M8.5 30.5c.8-5.2 4.6-8.2 10.4-8.2 2.2 0 4.1.4 5.6 1.2"></path>
        <path d="M22 24.5c1.8-1.2 4.2-1.6 7.6-.4 2.8 1 4.2 3.4 4.4 6.4"></path>
        <path class="accent" stroke="none" d="M19.2 22.5h1.6v6.2h-1.6z"></path>
        <path class="accent" stroke="none" d="M16.2 24.8h7.6v1.6h-7.6z"></path>
      </>
    )
  }
  {
    name === 'leaf' && (
      <>
        <path d="M10 31c7.5-15 21-19.5 24.2-20.2C32.4 24 26.6 32 10 31z"></path>
        <path d="M16.5 24.5 24 17"></path>
        <circle class="accent" cx="22.5" cy="20.2" r="1.7" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'drop' && (
      <>
        <path d="M20 5.8c7.4 9.2 11.2 14.8 11.2 20.6A11.2 11.2 0 1 1 8.8 26.4C8.8 20.6 12.6 15 20 5.8z"></path>
        <path class="accent" stroke="none" d="M19.2 22.2h1.6v6h-1.6z"></path>
        <path class="accent" stroke="none" d="M16.4 24.5h7.2v1.6h-7.2z"></path>
      </>
    )
  }
  {
    name === 'hex' && (
      <>
        <path d="M20 5.5 32.2 12.5v15L20 34.5 7.8 27.5v-15L20 5.5z"></path>
        <path d="M20 13.2 27.4 17.5v8.6L20 30.4l-7.4-4.3v-8.6L20 13.2z" stroke-width="1.3"></path>
        <circle class="accent" cx="20" cy="20" r="1.7" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'pulse' && (
      <>
        <rect x="6" y="9" width="28" height="22" rx="3.2"></rect>
        <path d="M10 20h4l2.4-5.5 3.6 11.2 2.6-5.7H30" stroke-width="1.9"></path>
        <circle class="accent" cx="30.2" cy="20" r="1.6" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'plus' && (
      <>
        <circle cx="20" cy="20" r="13.5"></circle>
        <path d="M20 13.2v13.6M13.2 20h13.6" stroke-width="2"></path>
        <circle class="accent" cx="20" cy="20" r="2" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'pack' && (
      <>
        <rect x="8" y="11" width="24" height="20" rx="2.2"></rect>
        <path d="M8 17h24M16 11V8.2h8V11"></path>
        <circle class="accent" cx="15.2" cy="23.5" r="1.5" stroke="none"></circle>
        <circle class="accent" cx="20" cy="23.5" r="1.5" stroke="none"></circle>
        <circle class="accent" cx="24.8" cy="23.5" r="1.5" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="20" cy="20" r="12.5"></circle>
        <ellipse cx="20" cy="20" rx="6" ry="12.5"></ellipse>
        <path d="M8 20h24M11.2 13.2h17.6M11.2 26.8h17.6"></path>
        <circle class="accent" cx="27.2" cy="14.5" r="1.6" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="20" cy="20" r="13"></circle>
        <path d="M20 11.5V20l6.2 3.6" stroke-width="1.9"></path>
        <circle class="accent" cx="20" cy="20" r="1.8" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'phone' && (
      <>
        <path d="M14.2 7.8h5.4l1.7 5.4-3.6 2.2a16 16 0 0 0 6.6 6.6l2.2-3.6 5.4 1.7v5.2c-9 .8-20.2-8.4-17.7-17.5z"></path>
        <circle class="accent" cx="16.2" cy="11.4" r="1.4" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'wa' && (
      <>
        <path d="M20 7.2c-6.8 0-12.4 5.3-12.4 11.8 0 2.1.6 4 1.7 5.7L7.2 32.5l7-1.8c1.6.8 3.5 1.3 5.5 1.3 6.8 0 12.4-5.3 12.4-11.8S26.8 7.2 20 7.2z"></path>
        <path d="M15.4 16.4c.2-.6.5-.7.8-.7h.7c.2 0 .5 0 .6.5.2.6.7 2 .8 2.2.1.2 0 .4-.2.6l-.5.6c-.2.2-.2.4 0 .7.3.5 1.3 1.6 2.6 2.2.4.2.7.2.9 0l.7-.8c.2-.2.5-.2.8 0l2.1 1.1c.3.2.4.5.3.8-.2 1.1-1.4 2.3-3 2.1-2.6-.3-6.6-2.6-8-6.6-.4-1.2.2-2.4 1.4-2.7z" stroke-width="1.2"></path>
        <circle class="accent" cx="26.6" cy="14.2" r="1.5" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="6.5" y="11" width="27" height="18" rx="2.2"></rect>
        <path d="M6.5 13.2 20 22.4 33.5 13.2"></path>
        <path class="accent" stroke="none" d="M18.8 20.4h2.4v2.4h-2.4z"></path>
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M20 34.2s-9.5-10.2-9.5-16.4A9.5 9.5 0 1 1 29.5 17.8C29.5 24 20 34.2 20 34.2z"></path>
        <circle cx="20" cy="17.4" r="3.4"></circle>
        <circle class="accent" cx="20" cy="17.4" r="1.5" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'lock' && (
      <>
        <rect x="11" y="17.5" width="18" height="14" rx="2.2"></rect>
        <path d="M15.2 17.5V13.8a4.8 4.8 0 1 1 9.6 0v3.7"></path>
        <circle class="accent" cx="20" cy="24.6" r="1.7" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'spark' && (
      <>
        <path d="M20 6.2 22.4 16.4 33 18.8 22.4 21.4 20 33.8 17.6 21.4 7 18.8 17.6 16.4 20 6.2z"></path>
        <circle class="accent" cx="20" cy="18.8" r="2" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'user' && (
      <>
        <circle cx="20" cy="14.2" r="5.4"></circle>
        <path d="M8.8 32.2c1.2-6.4 5.4-9.4 11.2-9.4s10 3 11.2 9.4"></path>
        <circle class="accent" cx="26.4" cy="13.2" r="1.5" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'cross' && (
      <>
        <path d="M16.2 8.5h7.6v7.7h7.7v7.6h-7.7v7.7h-7.6v-7.7H8.5v-7.6h7.7V8.5z"></path>
        <circle class="accent" cx="20" cy="20" r="1.8" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'arrow' && (
      <>
        <path d="M8 20h22M22.5 11.5 32 20l-9.5 8.5"></path>
        <circle class="accent" cx="11.2" cy="20" r="1.5" stroke="none"></circle>
      </>
    )
  }
  {
    name === 'india' && (
      <>
        <circle cx="20" cy="20" r="12.5"></circle>
        <ellipse cx="20" cy="20" rx="6" ry="12.5"></ellipse>
        <path d="M8 20h24"></path>
        <circle class="accent" cx="27.2" cy="14.5" r="1.6" stroke="none"></circle>
      </>
    )
  }
</svg>

<style>
  .icon {
    overflow: visible;
  }
  .icon .accent {
    fill: var(--gold, #c4a35a);
    stroke: none;
  }
  :global(.icon-tile.on-navy) .accent,
  :global(.dock a) .accent {
    fill: #e0c078;
  }
</style>
