---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 40 } = Astro.props;

const paths: Record<string, string> = {
  heart:
    'M20 34s-12-7.5-12-16A8 8 0 0 1 20 12a8 8 0 0 1 12 6c0 8.5-12 16-12 16z',
  shield:
    'M20 6 8 11v9c0 8 5.2 13.4 12 15 6.8-1.6 12-7 12-15v-9L20 6zm0 8v14',
  care:
    'M8 22c0-7 5.4-12 12-12s12 5 12 12-5.4 10-12 10S8 29 8 22zm12-6v12m-6-6h12',
  leaf:
    'M10 30c8-16 22-20 24-20-2 14-8 22-24 20zm8-8 6 6',
  drop: 'M20 6c8 10 12 16 12 22a12 12 0 0 1-24 0c0-6 4-12 12-22z',
  hex: 'M20 6 32 13v14L20 34 8 27V13L20 6z',
  pulse:
    'M6 22h6l3-8 5 16 4-10h10',
  plus: 'M20 8v24M8 20h24',
  pack: 'M8 12h24v20H8zM8 18h24M16 12V8h8v4',
  india:
    'M8 28c4-10 10-18 24-20M10 16c6 2 10 8 12 16M28 12c-2 8 2 16 6 18',
  globe:
    'M20 8a12 12 0 1 1 0 24 12 12 0 0 1 0-24zM8 20h24M20 8c4 4 6 8 6 12s-2 8-6 12c-4-4-6-8-6-12s2-8 6-12z',
  clock:
    'M20 8a14 14 0 1 1 0 28 14 14 0 0 1 0-28zm0 6v8l6 4',
  phone:
    'M12 8h6l2 6-4 3a18 18 0 0 0 7 7l3-4 6 2v6c-10 1-22-9-20-20z',
  wa: 'M20 7c-7.2 0-13 5.6-13 12.5 0 2.2.6 4.3 1.8 6.1L7 33l7.2-1.9c1.7.9 3.7 1.4 5.8 1.4 7.2 0 13-5.6 13-12.5S27.2 7 20 7z',
  mail: 'M6 12h28v16H6zM6 12l14 10L34 12',
  arrow: 'M8 20h22M22 10l10 10-10 10',
};
const d = paths[name] ?? paths.plus;
---

<svg class="icon" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <path
    d={d}
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
