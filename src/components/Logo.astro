---
interface Props {
  variant?: 'mark' | 'lockup';
  animated?: boolean;
  invert?: boolean;
  title?: string;
}
const { variant = 'lockup', animated = false, invert = false, title = 'Dinymeo' } = Astro.props;
const id = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['logo', variant, { anim: animated, invert }]}
  viewBox={variant === 'mark' ? '0 0 200 186' : '0 0 200 248'}
  role="img"
  aria-labelledby={`${id}-title`}
>
  <title id={`${id}-title`}>{title}</title>
  <defs>
    <linearGradient id={`${id}-leaf`} x1="0" x2="1">
      <stop offset="0" stop-color="#1E78FE"></stop>
      <stop offset="1" stop-color="#4FD8FE"></stop>
    </linearGradient>
  </defs>
  <g class="mark" transform="translate(0 0)">
    <path
      class="leaf-l"
      fill="#1E78FE"
      d="M100 182 C28 176 6 108 36 78 C58 110 78 148 100 182Z"></path>
    <path
      class="leaf-r"
      fill="#2B8CFF"
      d="M100 182 C172 176 194 108 164 78 C142 110 122 148 100 182Z"></path>
    <path
      class="d-outer"
      fill="#0A12F5"
      d="M56 18 H118 C166 18 180 48 180 84 C180 120 166 152 118 152 H56 V18Z"></path>
    <path
      class="d-inner"
      fill="#4FD8FE"
      d="M64 30 H96 C114 30 122 40 122 56 V92 C118 114 100 126 78 132 H64 V30Z"></path>
    <path class="d-drop" fill="#1E78FE" d="M78 108 L124 100 L100 160 Z"></path>
  </g>
  {
    variant === 'lockup' && (
      <text class="word" x="100" y="232" text-anchor="middle">
        Dinymeo
      </text>
    )
  }
</svg>

<style>
  .logo {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .logo.mark {
    width: 2.5rem;
  }
  .logo.lockup.anim,
  .logo.lockup {
    width: 9.5rem;
  }
  .word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 42px;
    fill: #01008e;
    letter-spacing: -1.5px;
  }
  .invert .word {
    fill: #fff;
  }
  .invert .d-outer {
    fill: #4fd8fe;
  }

  .anim .leaf-l,
  .anim .leaf-r {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: bloom 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .anim .leaf-r {
    animation-delay: 0.12s;
  }
  .anim .d-outer,
  .anim .d-inner,
  .anim .d-drop {
    animation: settle 0.9s 0.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .anim .d-inner {
    animation-delay: 0.32s;
  }
  .anim .d-drop {
    animation-delay: 0.42s;
  }
  .anim .word {
    animation: fade 0.7s 0.7s both;
  }

  @keyframes bloom {
    from {
      transform: scale(0.4, 0.15);
      opacity: 0.2;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes settle {
    from {
      transform: translateY(-12px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim * {
      animation: none !important;
    }
  }
</style>
