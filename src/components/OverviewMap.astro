---
/**
 * Company overview: one partner from brief to brand.
 * Decorative; labels stay English on every locale.
 */
---

<svg class="overview-map" viewBox="0 0 1200 720" role="img" aria-hidden="true">
  <defs>
    <linearGradient id="ov-line" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#50ADE5"></stop>
      <stop offset="100%" stop-color="#C4A35A"></stop>
    </linearGradient>
  </defs>
  <g class="ov-links" fill="none" stroke="url(#ov-line)" stroke-width="1.35" stroke-linecap="round">
    <path class="ov-link" d="M800 350 L560 160"></path>
    <path class="ov-link" d="M800 350 L700 140"></path>
    <path class="ov-link" d="M800 350 L860 130"></path>
    <path class="ov-link" d="M800 350 L1020 170"></path>
    <path class="ov-link" d="M800 350 L1100 300"></path>
    <path class="ov-link" d="M800 350 L1080 450"></path>
    <path class="ov-link" d="M800 350 L960 560"></path>
    <path class="ov-link" d="M800 350 L800 590"></path>
    <path class="ov-link" d="M800 350 L640 560"></path>
    <path class="ov-link" d="M800 350 L500 450"></path>
    <path class="ov-link" d="M800 350 L490 300"></path>
    <path class="ov-link" d="M560 160 L700 140 L860 130 L1020 170 L1100 300"></path>
  </g>

  <g class="ov-node ov-core" style="--d:0s">
    <circle cx="800" cy="350" r="66"></circle>
    <path class="ov-ico" d="M788 336h24v5h-24zm3-9h18v5h-18zm-1 18h20v5h-20z"></path>
    <text x="800" y="374" text-anchor="middle">Dinymeo</text>
  </g>

  <g class="ov-node" style="--d:.08s" transform="translate(560 160)">
    <circle r="36"></circle>
    <path class="ov-ico" d="M-8 -8h16v12h-16zM-5 -4h10" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Brief</text>
  </g>
  <g class="ov-node" style="--d:.12s" transform="translate(700 140)">
    <circle r="38"></circle>
    <path class="ov-ico" d="M0 -9l8 5v8l-8 5-8-5v-8z"></path>
    <text y="22" text-anchor="middle">Formulation</text>
  </g>
  <g class="ov-node" style="--d:.16s" transform="translate(860 130)">
    <circle r="34"></circle>
    <path class="ov-ico" d="M0 -10 8 -4v10L0 12l-8-6V-4z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">QA</text>
  </g>
  <g class="ov-node" style="--d:.2s" transform="translate(1020 170)">
    <circle r="36"></circle>
    <path class="ov-ico" d="M-9 -6h18v12h-18zM-9 0h18M-3 -6v12M3 -6v12" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Pack</text>
  </g>
  <g class="ov-node" style="--d:.24s" transform="translate(1100 300)">
    <circle r="36"></circle>
    <circle class="ov-ico" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path class="ov-ico" d="M-8 0h16M0 -8c3 4 4 8 4 8s-1 4-4 8c-3-4-4-8-4-8s1-4 4-8z" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    <text y="22" text-anchor="middle">Supply</text>
  </g>
  <g class="ov-node" style="--d:.28s" transform="translate(1080 450)">
    <circle r="38"></circle>
    <path class="ov-ico" d="M-7 -8h14v4h-14zm-2 4h18v12h-18z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Your brand</text>
  </g>
  <g class="ov-node" style="--d:.32s" transform="translate(960 560)">
    <circle r="36"></circle>
    <path class="ov-ico" d="M-8 -6h16M-8 -1h16M-8 4h10" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    <text y="22" text-anchor="middle">Catalogue</text>
  </g>
  <g class="ov-node" style="--d:.36s" transform="translate(800 590)">
    <circle r="34"></circle>
    <path class="ov-ico" d="M-2 -9v10l6 4" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    <circle class="ov-ico" r="10" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <text y="22" text-anchor="middle">On-time</text>
  </g>
  <g class="ov-node" style="--d:.4s" transform="translate(640 560)">
    <circle r="36"></circle>
    <path class="ov-ico" d="M-7 -2h14v8h-14zM-4 -6h8v4h-8z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Confidential</text>
  </g>
  <g class="ov-node" style="--d:.44s" transform="translate(500 450)">
    <circle r="36"></circle>
    <path class="ov-ico" d="M0 -9c6 8 9 12 9 16a9 9 0 1 1-18 0c0-4 3-8 9-16z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Therapy</text>
  </g>
  <g class="ov-node" style="--d:.18s" transform="translate(490 300)">
    <circle r="34"></circle>
    <path class="ov-ico" d="M-8 -6h16v12h-16zM-4 -2h8v4h-8z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Batch</text>
  </g>
</svg>

<style>
  .overview-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    color: #e0c078;
  }
  .ov-core circle {
    fill: color-mix(in srgb, #1b1d4a 70%, transparent);
    stroke: #c4a35a;
    stroke-width: 2;
  }
  .ov-node circle {
    fill: color-mix(in srgb, #12141c 78%, transparent);
    stroke: #50ade5;
    stroke-width: 1.4;
  }
  .ov-node text {
    fill: #f4f7ff;
    font-size: 11px;
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .ov-core text {
    font-size: 13px;
    fill: #fff;
  }
  .ov-ico {
    fill: #c4a35a;
    transform: translateY(-6px);
  }
  .ov-link {
    stroke-dasharray: 280;
    stroke-dashoffset: 280;
  }
  :global(.hero-slide.is-active) .ov-link {
    animation:
      ov-draw 0.55s ease forwards,
      ov-flow 9s linear 0.6s infinite;
  }
  .ov-node {
    opacity: 0;
  }
  :global(.hero-slide.is-active) .ov-node {
    animation: ov-pop 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes ov-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes ov-flow {
    from {
      stroke-dasharray: 5 9;
      stroke-dashoffset: 0;
    }
    to {
      stroke-dasharray: 5 9;
      stroke-dashoffset: -80;
    }
  }
  @keyframes ov-pop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ov-link,
    :global(.hero-slide.is-active) .ov-link,
    :global(.hero-slide.is-active) .ov-node {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
