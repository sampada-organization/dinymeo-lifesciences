---
/**
 * Primary-pack science mindmap (ICH Q1 barrier logic → pack family).
 * Decorative; labels are scientific English on every locale.
 */
---

<svg class="pack-mindmap" viewBox="0 0 1200 720" role="img" aria-hidden="true">
  <defs>
    <linearGradient id="mm-line" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#50ADE5"></stop>
      <stop offset="100%" stop-color="#C4A35A"></stop>
    </linearGradient>
  </defs>
  <g class="mm-links" fill="none" stroke="url(#mm-line)" stroke-width="1.35" stroke-linecap="round">
    <path class="mm-link" d="M800 350 L800 145"></path>
    <path class="mm-link" d="M800 350 L980 175"></path>
    <path class="mm-link" d="M800 350 L1070 280"></path>
    <path class="mm-link" d="M800 350 L1090 365"></path>
    <path class="mm-link" d="M800 350 L1055 470"></path>
    <path class="mm-link" d="M800 350 L920 555"></path>
    <path class="mm-link" d="M800 350 L800 590"></path>
    <path class="mm-link" d="M800 350 L680 555"></path>
    <path class="mm-link" d="M800 350 L560 500"></path>
    <path class="mm-link" d="M800 350 L530 400"></path>
    <path class="mm-link" d="M800 350 L560 175"></path>
    <path class="mm-link" d="M800 350 L490 255"></path>
    <path class="mm-link" d="M800 350 L470 350"></path>
    <path class="mm-link" d="M800 350 L500 445"></path>
    <path class="mm-link" d="M800 350 L680 120"></path>
  </g>

  <g class="mm-node mm-core" style="--d:0s">
    <circle cx="800" cy="350" r="62"></circle>
    <path class="mm-ico" d="M788 338h24v6h-24zm4-10h16v6h-16zm-2 20h20v6h-20z"></path>
    <text x="800" y="372" text-anchor="middle">Formulation</text>
  </g>

  <g class="mm-node" style="--d:.08s" transform="translate(800 145)">
    <circle r="34"></circle>
    <path class="mm-ico" d="M0 -10l9 5v10l-9 5-9-5V-5z"></path>
    <text y="22" text-anchor="middle">API</text>
  </g>
  <g class="mm-node" style="--d:.12s" transform="translate(980 175)">
    <circle r="36"></circle>
    <path class="mm-ico" d="M0 -9c4 0 7 4 7 8 0 6-7 12-7 12s-7-6-7-12c0-4 3-8 7-8z"></path>
    <text y="22" text-anchor="middle">Excipient</text>
  </g>
  <g class="mm-node" style="--d:.16s" transform="translate(1070 280)">
    <circle r="38"></circle>
    <path class="mm-ico" d="M-8 -4h4v4h-4zm6-4h4v4h-4zm6 4h4v4h-4zm-9 6h4v4h-4zm6 2h4v4h-4z"></path>
    <text y="22" text-anchor="middle">Granulation</text>
  </g>
  <g class="mm-node" style="--d:.2s" transform="translate(1090 365)">
    <circle r="38"></circle>
    <rect class="mm-ico" x="-8" y="-8" width="16" height="10" rx="2"></rect>
    <text y="22" text-anchor="middle">Compression</text>
  </g>
  <g class="mm-node" style="--d:.24s" transform="translate(1055 470)">
    <circle r="36"></circle>
    <circle class="mm-ico" r="7" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <text y="22" text-anchor="middle">Coating</text>
  </g>
  <g class="mm-node" style="--d:.28s" transform="translate(920 555)">
    <circle r="36"></circle>
    <path class="mm-ico" d="M-8 4h16M-8 4c0-8 16-8 16 0" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    <text y="22" text-anchor="middle">WVTR</text>
  </g>
  <g class="mm-node" style="--d:.32s" transform="translate(800 590)">
    <circle r="34"></circle>
    <text class="mm-ico-t" y="-2" text-anchor="middle">O₂</text>
    <text y="22" text-anchor="middle">OTR</text>
  </g>
  <g class="mm-node" style="--d:.36s" transform="translate(680 555)">
    <circle r="34"></circle>
    <path class="mm-ico" d="M0 -8l2 5h5l-4 3 2 5-5-3-5 3 2-5-4-3h5z"></path>
    <text y="22" text-anchor="middle">Light</text>
  </g>
  <g class="mm-node" style="--d:.4s" transform="translate(560 500)">
    <circle r="38"></circle>
    <text class="mm-ico-t" y="-4" text-anchor="middle">Q1A</text>
    <text y="22" text-anchor="middle">ICH Q1A</text>
  </g>
  <g class="mm-node" style="--d:.44s" transform="translate(530 400)">
    <circle r="36"></circle>
    <text class="mm-ico-t" y="-4" text-anchor="middle">Q1B</text>
    <text y="22" text-anchor="middle">ICH Q1B</text>
  </g>
  <g class="mm-node" style="--d:.18s" transform="translate(680 120)">
    <circle r="34"></circle>
    <path class="mm-ico" d="M-3 -10h6v5h-6zm-4 5h14l2 16h-18z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Tube</text>
  </g>
  <g class="mm-node" style="--d:.22s" transform="translate(560 175)">
    <circle r="36"></circle>
    <path class="mm-ico" d="M-10 -6h20v12h-20zM-10 -2h20M-3 -6v12M4 -6v12" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Alu-Alu</text>
  </g>
  <g class="mm-node" style="--d:.26s" transform="translate(490 255)">
    <circle r="36"></circle>
    <circle class="mm-ico" cx="-6" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
    <circle class="mm-ico" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
    <circle class="mm-ico" cx="6" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
    <text y="22" text-anchor="middle">Blister</text>
  </g>
  <g class="mm-node" style="--d:.3s" transform="translate(470 350)">
    <circle r="34"></circle>
    <path class="mm-ico" d="M-10 -5h20v10h-20zM-3 -5v10M3 -5v10" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Strip</text>
  </g>
  <g class="mm-node" style="--d:.34s" transform="translate(500 445)">
    <circle r="36"></circle>
    <path class="mm-ico" d="M-3 -10h6v4h-6zm-3 4h12l1 14h-14z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    <text y="22" text-anchor="middle">Bottle</text>
  </g>
</svg>

<style>
  .pack-mindmap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    color: #e0c078;
  }
  .mm-core circle {
    fill: color-mix(in srgb, #1b1d4a 70%, transparent);
    stroke: #c4a35a;
    stroke-width: 2;
  }
  .mm-node circle {
    fill: color-mix(in srgb, #12141c 78%, transparent);
    stroke: #50ade5;
    stroke-width: 1.4;
  }
  .mm-node text {
    fill: #f4f7ff;
    font-size: 11px;
    font-family: Montserrat, system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .mm-core text {
    font-size: 13px;
    fill: #fff;
  }
  .mm-ico {
    fill: #c4a35a;
    transform: translateY(-6px);
  }
  .mm-ico-t {
    fill: #c4a35a;
    font-size: 9px;
    font-weight: 800;
  }
  .mm-link {
    stroke-dasharray: 280;
    stroke-dashoffset: 280;
  }
  :global(.hero-slide.is-active) .mm-link {
    animation:
      mm-draw 0.55s ease forwards,
      mm-flow 9s linear 0.6s infinite;
  }
  .mm-node {
    opacity: 0;
  }
  :global(.hero-slide.is-active) .mm-node {
    animation: mm-pop 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes mm-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes mm-flow {
    from {
      stroke-dasharray: 5 9;
      stroke-dashoffset: 0;
    }
    to {
      stroke-dasharray: 5 9;
      stroke-dashoffset: -80;
    }
  }
  @keyframes mm-pop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mm-link,
    :global(.hero-slide.is-active) .mm-link,
    :global(.hero-slide.is-active) .mm-node {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
