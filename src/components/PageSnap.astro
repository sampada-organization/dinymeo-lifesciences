---

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const flow = document.querySelector('.page-flow');

  if (flow instanceof HTMLElement) {
    const panes = () =>
      [...flow.querySelectorAll('[data-section]')].filter(
        (node): node is HTMLElement =>
          node instanceof HTMLElement && !node.classList.contains('site-footer'),
      );

    let index = 0;
    let locked = false;
    let acc = 0;
    let touchY = 0;
    let touchX = 0;

    const maxScroll = () => Math.max(0, flow.scrollHeight - flow.clientHeight);

    const currentIndex = () => {
      const list = panes();
      if (!list.length) return 0;
      const last = list[list.length - 1];
      const mid = flow.scrollTop + flow.clientHeight * 0.45;
      if (mid > last.offsetTop + last.offsetHeight) return list.length;
      let best = 0;
      let dist = Infinity;
      list.forEach((el, i) => {
        const d = Math.abs(el.offsetTop + el.clientHeight * 0.45 - mid);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };

    const go = (next: number) => {
      const list = panes();
      if (!list.length) return;
      if (next < 0) return;
      if (next >= list.length) {
        const end = maxScroll();
        if (flow.scrollTop >= end - 4) return;
        index = list.length;
        flow.scrollTo({ top: end, behavior: reduced ? 'auto' : 'smooth' });
        return;
      }
      const el = list[next];
      if (next === index && Math.abs(el.offsetTop - flow.scrollTop) < 4) return;
      index = next;
      el.scrollTop = 0;
      flow.scrollTo({ top: el.offsetTop, behavior: reduced ? 'auto' : 'smooth' });
    };

    const overflowing = (el: HTMLElement, dir: number) => {
      if (el.classList.contains('hero')) return false;
      const overflowY = getComputedStyle(el).overflowY;
      if (overflowY === 'hidden' || overflowY === 'clip') return false;
      if (el.scrollHeight <= el.clientHeight + 8) return false;
      if (dir > 0) return el.scrollTop + el.clientHeight < el.scrollHeight - 8;
      return el.scrollTop > 8;
    };

    index = currentIndex();

    flow.addEventListener(
      'scroll',
      () => {
        index = currentIndex();
      },
      { passive: true },
    );

    if (!reduced) {
      flow.addEventListener(
        'wheel',
        (event) => {
          if (event.ctrlKey) return;
          if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
          const target = event.target;
          if (target instanceof Element && target.closest('input, textarea, select')) return;
          if (
            target instanceof Element &&
            target.closest('.flow-frame') &&
            Math.abs(event.deltaX) >= Math.abs(event.deltaY)
          ) {
            return;
          }
          const i = currentIndex();
          const list = panes();
          const pane = i < list.length ? list[i] : null;
          if (pane && overflowing(pane, event.deltaY)) {
            event.preventDefault();
            pane.scrollTop += event.deltaY;
            return;
          }
          event.preventDefault();
          if (locked) return;
          acc += event.deltaY;
          if (Math.abs(acc) < 28) return;
          const dir = acc > 0 ? 1 : -1;
          acc = 0;
          locked = true;
          go(i + dir);
          window.setTimeout(() => {
            locked = false;
          }, 720);
        },
        { passive: false },
      );

      const beginSwipe = (x: number, y: number) => {
        touchX = x;
        touchY = y;
      };

      const endSwipe = (x: number, y: number, target: EventTarget | null) => {
        const dy = touchY - y;
        const dx = touchX - x;
        if (Math.abs(dy) < 36 || Math.abs(dy) <= Math.abs(dx)) return;
        if (target instanceof Element && target.closest('a, button, input, textarea, select')) {
          return;
        }
        const i = currentIndex();
        const list = panes();
        const pane = i < list.length ? list[i] : null;
        if (pane && overflowing(pane, dy)) return;
        if (locked) return;
        locked = true;
        go(i + (dy > 0 ? 1 : -1));
        window.setTimeout(() => {
          locked = false;
        }, 720);
      };

      flow.addEventListener(
        'touchstart',
        (event) => {
          const touch = event.touches[0];
          if (touch) beginSwipe(touch.clientX, touch.clientY);
        },
        { passive: true },
      );

      flow.addEventListener(
        'touchend',
        (event) => {
          const touch = event.changedTouches[0];
          if (touch) endSwipe(touch.clientX, touch.clientY, event.target);
        },
        { passive: true },
      );

      flow.addEventListener(
        'pointerdown',
        (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          beginSwipe(event.clientX, event.clientY);
        },
        { passive: true },
      );

      flow.addEventListener(
        'pointerup',
        (event) => {
          endSwipe(event.clientX, event.clientY, event.target);
        },
        { passive: true },
      );
    }

    window.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement) {
        const tag = target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target.isContentEditable) {
          return;
        }
      }
      const i = currentIndex();
      const list = panes();
      const pane = i < list.length ? list[i] : null;
      if (event.key === 'PageDown' || event.key === 'ArrowDown' || event.key === ' ') {
        if (pane && overflowing(pane, 1) && event.key !== 'PageDown') return;
        event.preventDefault();
        go(i + 1);
      } else if (event.key === 'PageUp' || event.key === 'ArrowUp') {
        if (pane && overflowing(pane, -1) && event.key === 'ArrowUp') return;
        event.preventDefault();
        go(i - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        go(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        go(list.length);
      }
    });
  }
</script>
