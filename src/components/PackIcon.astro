---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 48 } = Astro.props;
---

<svg class="icon pack-icon" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  {
    name === 'alu-alu' && (
      <>
        <rect x="8" y="10" width="32" height="28" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M8 18h32M8 30h32" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M14 18v12M24 18v12M34 18v12" fill="none" stroke="currentColor" stroke-width="1.4" />
        <circle cx="19" cy="24" r="1.4" fill="currentColor" />
        <circle cx="29" cy="24" r="1.4" fill="currentColor" />
      </>
    )
  }
  {
    name === 'blister' && (
      <>
        <rect x="7" y="12" width="34" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" />
        <circle cx="16" cy="24" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="24" cy="24" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="32" cy="24" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <circle cx="16" cy="24" r="1.5" fill="currentColor" />
        <circle cx="24" cy="24" r="1.5" fill="currentColor" />
        <circle cx="32" cy="24" r="1.5" fill="currentColor" />
      </>
    )
  }
  {
    name === 'strip' && (
      <>
        <path d="M8 16h32v16H8z" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M16 16v16M24 16v16M32 16v16" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 24h32" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" />
      </>
    )
  }
  {
    name === 'bottle' && (
      <>
        <path d="M20 8h8v5h-8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        <path d="M18 13h12l2 6v17a3 3 0 0 1-3 3H19a3 3 0 0 1-3-3V19l2-6z" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M18 22h12" fill="none" stroke="currentColor" stroke-width="1.4" />
      </>
    )
  }
  {
    name === 'tube' && (
      <>
        <rect x="20" y="6" width="8" height="7" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M18 13h12l3 5v16c0 3.2-3.2 6-9 6s-9-2.8-9-6V18l3-5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        <path d="M18 36h12M21 18h6" fill="none" stroke="currentColor" stroke-width="1.4" />
      </>
    )
  }
</svg>
