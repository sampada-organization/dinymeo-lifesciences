---
interface Props {
  name: string;
  size?: number;
}
const { name, size = 48 } = Astro.props;
---

<svg
  class="icon pack-icon"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'alu-alu' && (
      <>
        <rect x="8" y="9" width="32" height="30" rx="2.4" stroke-width="1.8"></rect>
        <path d="M8 17.5h32M8 30.5h32" stroke-width="1.5"></path>
        <path d="M16 17.5v13M24 17.5v13M32 17.5v13" stroke-width="1.3"></path>
        <circle class="accent" cx="20" cy="24" r="1.7" stroke="none" fill="currentColor"></circle>
        <circle class="accent" cx="28" cy="24" r="1.7" stroke="none" fill="currentColor"></circle>
      </>
    )
  }
  {
    name === 'blister' && (
      <>
        <rect x="6.5" y="12" width="35" height="24" rx="3.2" stroke-width="1.8"></rect>
        <circle cx="16" cy="24" r="4.4" stroke-width="1.5"></circle>
        <circle cx="24" cy="24" r="4.4" stroke-width="1.5"></circle>
        <circle cx="32" cy="24" r="4.4" stroke-width="1.5"></circle>
        <circle class="accent" cx="16" cy="24" r="1.6" stroke="none" fill="currentColor"></circle>
        <circle class="accent" cx="24" cy="24" r="1.6" stroke="none" fill="currentColor"></circle>
        <circle class="accent" cx="32" cy="24" r="1.6" stroke="none" fill="currentColor"></circle>
      </>
    )
  }
  {
    name === 'strip' && (
      <>
        <path d="M8 15.5h32v17H8z" stroke-width="1.8"></path>
        <path d="M16 15.5v17M24 15.5v17M32 15.5v17" stroke-width="1.4"></path>
        <path d="M8 24h32" stroke-width="1.2" stroke-dasharray="2.2 2.4"></path>
        <circle class="accent" cx="20" cy="24" r="1.5" stroke="none" fill="currentColor"></circle>
        <circle class="accent" cx="28" cy="24" r="1.5" stroke="none" fill="currentColor"></circle>
      </>
    )
  }
  {
    name === 'bottle' && (
      <>
        <path d="M20 7h8v5.2h-8z" stroke-width="1.8"></path>
        <path d="M18.2 12.2h11.6l2.1 5.6v18.2a3.2 3.2 0 0 1-3.2 3.2H19.3a3.2 3.2 0 0 1-3.2-3.2V17.8l2.1-5.6z" stroke-width="1.8"></path>
        <path d="M17.4 22.5h13.2" stroke-width="1.4"></path>
        <circle class="accent" cx="24" cy="30.5" r="1.7" stroke="none" fill="currentColor"></circle>
      </>
    )
  }
  {
    name === 'tube' && (
      <>
        <rect x="20" y="5.5" width="8" height="7.2" rx="1.5" stroke-width="1.8"></rect>
        <path d="M18 12.7h12l3.1 5.2v16.6c0 3.3-3.3 6.2-9.1 6.2s-9.1-2.9-9.1-6.2V17.9L18 12.7z" stroke-width="1.8"></path>
        <path d="M18 36.2h12M21.2 18.2h5.6" stroke-width="1.4"></path>
        <circle class="accent" cx="24" cy="26" r="1.6" stroke="none" fill="currentColor"></circle>
      </>
    )
  }
</svg>

<style>
  .pack-icon .accent {
    fill: var(--gold, #c4a35a);
  }
</style>
