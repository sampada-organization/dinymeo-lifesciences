---
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
const steps = c.home.flow;
const n = steps.length;
const x0 = 72;
const x1 = 1208;
const xs = steps.map((_, i) => x0 + (i * (x1 - x0)) / Math.max(1, n - 1));
const formX = xs[2] ?? 247;
const qaX = xs[4] ?? 414;
---

<div class="flow-frame" data-flow data-count={n} data-x0={x0} data-x1={x1}>
  <svg class="flow-scene" viewBox="0 0 1280 440" role="img" aria-labelledby="flow-svg-title">
    <title id="flow-svg-title">{c.home.flowTitle}</title>
    <defs>
      <linearGradient id="flow-spine" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#C4A35A"></stop>
        <stop offset="50%" stop-color="#50ADE5"></stop>
        <stop offset="100%" stop-color="#2E3192"></stop>
      </linearGradient>
    </defs>

    <text class="lane" x="24" y="44">{c.home.flowPartner}</text>
    <text class="lane lane-ops" x="24" y="422">{c.home.flowOps}</text>
    <line class="lane-rule" x1="24" y1="54" x2="1256" y2="54"></line>
    <line class="lane-rule ops" x1="24" y1="406" x2="1256" y2="406"></line>

    <path class="spine" d={`M${x0} 230 H${x1}`} fill="none" stroke="url(#flow-spine)" stroke-width="3" stroke-linecap="round"></path>

    <path
      class="sync-loop"
      d={`M${formX} 230 C${formX} 132 ${qaX} 132 ${qaX} 230`}
      fill="none"
      stroke="#50ADE5"
      stroke-width="1.6"></path>
    <text class="sync-label" x={(formX + qaX) / 2} y="118" text-anchor="middle">{c.home.flowSync}</text>

    <g class="courier" data-courier transform={`translate(${x0} 230)`}>
      <g class="carry" data-carry="0">
        <rect x="-7" y="-9" width="14" height="18" rx="1.4" fill="#fff" stroke="#C4A35A" stroke-width="1.6"></rect>
        <path d="M-4 -4h8M-4 0h8M-4 4h5" stroke="#2E3192" stroke-width="1.3" fill="none"></path>
      </g>
      <g class="carry" data-carry="1" hidden>
        <path d="M0 -9c4 5 6 8 6 12a6 6 0 1 1-12 0c0-4 2-7 6-12z" fill="#50ADE5" stroke="#2E3192" stroke-width="1.2"></path>
      </g>
      <g class="carry" data-carry="2" hidden>
        <path d="M0 -8 6 -4.5v9L0 9l-6-4.5v-9L0 -8z" fill="#fff" stroke="#2E3192" stroke-width="1.4"></path>
        <circle cx="0" cy="0" r="1.6" fill="#C4A35A"></circle>
      </g>
      <g class="carry" data-carry="3" hidden>
        <circle cx="0" cy="0" r="9" fill="#fff" stroke="#2E3192" stroke-width="1.5"></circle>
        <path d="M0 -5V0l4 2.4" stroke="#C4A35A" stroke-width="1.6" fill="none"></path>
      </g>
      <g class="carry" data-carry="4" hidden>
        <path d="M0 -9 8 -5.5v8.5C8 7 4 10 0 11c-4-1-8-4-8-8V-5.5L0 -9z" fill="#fff" stroke="#2E3192" stroke-width="1.4"></path>
        <path d="M-3 1 0 4l5-6" stroke="#C4A35A" stroke-width="1.6" fill="none"></path>
      </g>
      <g class="carry" data-carry="5" hidden>
        <rect x="-8" y="-6" width="16" height="12" rx="6" fill="#C4A35A"></rect>
        <rect x="-8" y="-6" width="7" height="12" rx="6" fill="#2E3192"></rect>
      </g>
      <g class="carry" data-carry="6" hidden>
        <rect x="-8" y="-7" width="16" height="14" rx="1.5" fill="#fff" stroke="#2E3192" stroke-width="1.4"></rect>
        <circle cx="-3" cy="1" r="1.5" fill="#C4A35A"></circle>
        <circle cx="3" cy="1" r="1.5" fill="#C4A35A"></circle>
      </g>
      <g class="carry" data-carry="7" hidden>
        <path d="M-8 0h14M6 -6l8 6-8 6" fill="none" stroke="#2E3192" stroke-width="1.7"></path>
        <circle cx="-8" cy="0" r="2" fill="#C4A35A"></circle>
      </g>
      <g class="carry" data-carry="8" hidden>
        <path d="M0 -9 1.8 -1.5 9 0 1.8 1.5 0 9 -1.8 1.5 -9 0 -1.8 -1.5Z" fill="#C4A35A" stroke="#2E3192" stroke-width="1.1"></path>
      </g>
    </g>

    {
      steps.map((step, i) => {
        const x = xs[i];
        const partner = i === 0 || i === n - 1;
        return (
          <g class="station" data-step={i} transform={`translate(${x} 230)`}>
            <circle class:list={['disc', { gold: partner }]} r="26"></circle>
            <text class="t" y={partner ? -78 : 56} text-anchor="middle">
              {step.title}
            </text>
            <text class="s" y={partner ? -60 : 74} text-anchor="middle">
              {step.text}
            </text>
          </g>
        );
      })
    }
  </svg>
</div>

<style>
  .flow-frame {
    margin-top: 2rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.4rem;
  }
  .flow-scene {
    width: max(100%, 56rem);
    height: auto;
    max-width: none;
    display: block;
  }
  .lane {
    fill: #9a7b32;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-family: Montserrat, system-ui, sans-serif;
  }
  .lane-ops {
    fill: #2e3192;
  }
  .lane-rule {
    stroke: #c4a35a;
    stroke-width: 1;
    opacity: 0.45;
  }
  .lane-rule.ops {
    stroke: #3871c1;
  }
  .spine {
    stroke-dasharray: 8 10;
    animation: flow-run 22s linear infinite;
  }
  .sync-loop {
    stroke-dasharray: 6 8;
    animation: flow-run 14s linear infinite reverse;
  }
  .sync-label {
    fill: #3871c1;
    font-size: 11px;
    font-weight: 700;
    font-family: Montserrat, system-ui, sans-serif;
  }
  .disc {
    fill: #ffffff;
    stroke: #50ade5;
    stroke-width: 2.2;
    transition: stroke 350ms ease, stroke-width 350ms ease, transform 350ms ease;
  }
  .disc.gold {
    stroke: #c4a35a;
    fill: #fffaf0;
  }
  .t {
    fill: #1b1d4a;
    font-size: 12.5px;
    font-weight: 800;
    font-family: Montserrat, system-ui, sans-serif;
    transition: fill 350ms ease, font-size 350ms ease;
  }
  .s {
    fill: #5a5f73;
    font-size: 10px;
    font-family: 'Source Sans 3', system-ui, sans-serif;
    transition: fill 350ms ease, font-size 350ms ease;
  }
  .station.is-focus .disc {
    stroke: #c4a35a;
    stroke-width: 3.4;
  }
  .station.is-focus .t {
    fill: #9a7b32;
    font-size: 16px;
  }
  .station.is-focus .s {
    fill: #2e3192;
    font-size: 11.5px;
  }
  .carry[hidden] {
    display: none;
  }
  @keyframes flow-run {
    to {
      stroke-dashoffset: -120;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spine,
    .sync-loop {
      animation: none;
    }
    .courier {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-flow]');
  const courier = root?.querySelector('[data-courier]');
  const stations = [...(root?.querySelectorAll('[data-step]') ?? [])];
  const carries = [...(root?.querySelectorAll('[data-carry]') ?? [])];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const n = Number(root?.getAttribute('data-count') || stations.length);
  const x0 = Number(root?.getAttribute('data-x0') || 72);
  const x1 = Number(root?.getAttribute('data-x1') || 1208);
  const duration = 22000;

  function setCarry(i) {
    const idx = Math.max(0, Math.min(carries.length - 1, i));
    carries.forEach((el, k) => {
      if (k === idx) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
  }

  if (!reduced && n && courier) {
    const tick = () => {
      const t = (performance.now() % duration) / duration;
      const pos = t * (n - 1);
      const x = x0 + t * (x1 - x0);
      courier.setAttribute('transform', `translate(${x} 230)`);
      const nearest = Math.round(pos);
      const here = Math.abs(pos - nearest) < 0.28;
      stations.forEach((el, idx) => el.classList.toggle('is-focus', here && idx === nearest));
      setCarry(Math.max(0, Math.floor(pos)));
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  } else {
    stations[0]?.classList.add('is-focus');
  }
</script>
