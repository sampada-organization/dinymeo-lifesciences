---
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
const steps = c.home.flow;
const xs = [80, 247, 414, 581, 748, 915, 1040];
---

<div class="flow-frame" data-flow>
  <svg class="flow-scene" viewBox="0 0 1120 430" role="img" aria-labelledby="flow-svg-title flow-svg-desc">
    <title id="flow-svg-title">{c.home.flowTitle}</title>
    <desc id="flow-svg-desc">{c.home.flowLead}</desc>
    <defs>
      <linearGradient id="flow-spine" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#C4A35A"></stop>
        <stop offset="45%" stop-color="#50ADE5"></stop>
        <stop offset="100%" stop-color="#2E3192"></stop>
      </linearGradient>
      <linearGradient id="flow-sync" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#C4A35A"></stop>
        <stop offset="100%" stop-color="#50ADE5"></stop>
      </linearGradient>
    </defs>

    <text class="lane" x="24" y="48">{c.home.flowPartner}</text>
    <text class="lane lane-ops" x="24" y="412">{c.home.flowOps}</text>
    <line class="lane-rule" x1="24" y1="58" x2="1096" y2="58"></line>
    <line class="lane-rule ops" x1="24" y1="396" x2="1096" y2="396"></line>

    <path
      class="spine"
      d="M80 230 H1040"
      fill="none"
      stroke="url(#flow-spine)"
      stroke-width="3"
      stroke-linecap="round"></path>

    <g class="courier">
      <ellipse cx="0" cy="0" rx="11" ry="6" fill="#C4A35A"></ellipse>
      <ellipse cx="-3" cy="0" rx="5" ry="6" fill="#2E3192"></ellipse>
      <path d="M2 -4.5h4.5v9H2z" fill="#50ADE5"></path>
      <animateMotion dur="18s" repeatCount="indefinite" path="M80 230 H1040"></animateMotion>
    </g>

    <path
      class="sync-loop"
      d="M247 230 C247 128 414 128 414 230 C414 178 247 178 247 230"
      fill="none"
      stroke="url(#flow-sync)"
      stroke-width="1.8"></path>
    <text class="sync-label" x="330" y="118" text-anchor="middle">{c.home.flowSync}</text>

    {
      steps.map((step, i) => {
        const x = xs[i];
        const partner = i === 0 || i === steps.length - 1;
        return (
          <g class="station" data-step={i} transform={`translate(${x} 230)`}>
            <circle class:list={['disc', { gold: partner }]} r="28"></circle>
            <text class="n" y="5" text-anchor="middle">{i + 1}</text>
            <text class="t" y={partner ? -86 : 62} text-anchor="middle">
              {step.title}
            </text>
            <text class="s" y={partner ? -68 : 80} text-anchor="middle">
              {step.text}
            </text>
          </g>
        );
      })
    }
  </svg>
</div>

<style>
  .flow-frame {
    margin-top: 2rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.4rem;
  }
  .flow-scene {
    width: max(100%, 48rem);
    height: auto;
    max-width: none;
    display: block;
  }
  .lane {
    fill: #9a7b32;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-family: Montserrat, system-ui, sans-serif;
  }
  .lane-ops {
    fill: #2e3192;
  }
  .lane-rule {
    stroke: #c4a35a;
    stroke-width: 1;
    opacity: 0.45;
  }
  .lane-rule.ops {
    stroke: #3871c1;
  }
  .spine {
    stroke-dasharray: 8 10;
    animation: flow-run 18s linear infinite;
  }
  .sync-loop {
    stroke-dasharray: 6 8;
    animation: flow-run 12s linear infinite reverse;
  }
  .sync-label {
    fill: #3871c1;
    font-size: 11px;
    font-weight: 700;
    font-family: Montserrat, system-ui, sans-serif;
    letter-spacing: 0.04em;
  }
  .disc {
    fill: #ffffff;
    stroke: #50ade5;
    stroke-width: 2.2;
    transition: stroke 400ms ease, stroke-width 400ms ease;
  }
  .disc.gold {
    stroke: #c4a35a;
    fill: #fffaf0;
  }
  .n {
    fill: #2e3192;
    font-size: 13px;
    font-weight: 800;
    font-family: Montserrat, system-ui, sans-serif;
  }
  .t {
    fill: #1b1d4a;
    font-size: 13px;
    font-weight: 800;
    font-family: Montserrat, system-ui, sans-serif;
    transition: fill 400ms ease, font-size 400ms ease;
  }
  .s {
    fill: #5a5f73;
    font-size: 10.5px;
    font-family: 'Source Sans 3', system-ui, sans-serif;
    transition: fill 400ms ease, font-size 400ms ease;
  }
  .station.is-focus .disc {
    stroke: #c4a35a;
    stroke-width: 3.2;
  }
  .station.is-focus .t {
    fill: #9a7b32;
    font-size: 16px;
  }
  .station.is-focus .s {
    fill: #2e3192;
    font-size: 12px;
  }
  @keyframes flow-run {
    to {
      stroke-dashoffset: -120;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spine,
    .sync-loop {
      animation: none;
    }
    .courier {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-flow]');
  const stations = [...(root?.querySelectorAll('[data-step]') ?? [])];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const duration = 18000;
  const n = stations.length;
  if (!reduced && n) {
    const tick = () => {
      const i = Math.min(n - 1, Math.floor((performance.now() % duration) / (duration / n)));
      stations.forEach((el, idx) => el.classList.toggle('is-focus', idx === i));
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  } else {
    stations[0]?.classList.add('is-focus');
  }
</script>
