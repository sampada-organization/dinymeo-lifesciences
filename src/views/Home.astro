---
import Base from '../layouts/Base.astro';
import Slideshow from '../components/Slideshow.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import ProcessScene from '../components/ProcessScene.astro';
import { t, type Locale } from '../lib/i18n';
import { localePath } from '../lib/paths';


interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
const links = [
  { href: localePath(lang, '/about'), label: c.nav.about },
  { href: localePath(lang, '/manufacturing'), label: c.nav.manufacturing },
  { href: localePath(lang, '/contact'), label: c.nav.contact },
];
---

<Base lang={lang} title={c.home.title} description={c.home.description} current="home">
  <Slideshow lang={lang} />

  <section>
    <div class="wrap">
      <p class="kicker">Dinymeo</p>
      <h2>{c.home.welcome}</h2>
      <p class="lede">{c.home.intro}</p>
      <p>{c.home.body}</p>
      <p class="kicker flow-kicker">{c.home.flowTitle}</p>
      <p class="lede">{c.home.flowLead}</p>
      <ProcessScene lang={lang} />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{c.home.linksTitle}</h2>
      <div class="intro-links">
        {links.map((link) => (
          <a href={link.href}>
            {link.label}
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band-navy">
    <div class="wrap">
      <h2>{c.home.promisesTitle}</h2>
      <div class="grid-4">
        {
          c.promises.map((p) => (
            <article class="card card-hover">
              <span class="icon-tile on-navy">
                <Icon name={p.icon} />
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-contact">
    <div class="wrap split-about">
      <article class="about-panel">
        <div>
          <p class="kicker">{c.nav.about}</p>
          <h2>{c.home.aboutTitle}</h2>
          <p class="lede">{c.home.aboutTeaser}</p>
          <ul class="about-points">
            {c.home.aboutPoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
        <p class="about-cta">
          <a class="btn navy" href={localePath(lang, '/about')}>{c.nav.about}</a>
        </p>
      </article>
      <aside class="form-panel">
        <h2>{c.home.contactTitle}</h2>
        <p>{c.home.formLead}</p>
        <EnquiryForm lang={lang} compact />
      </aside>
    </div>
  </section>
</Base>
