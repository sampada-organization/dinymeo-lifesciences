---
import Base from '../layouts/Base.astro';
import { t, type Locale } from '../lib/i18n';
import { qualityNote } from '../lib/site';
import { localePath } from '../lib/paths';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
---

<Base lang={lang} title={c.about.title} description={c.about.description} current="about">
  <section>
    <div class="wrap">
      <p class="kicker">{c.about.kicker}</p>
      <h1>{c.about.headline}</h1>
      <p class="lede">{c.about.overview}</p>
      <p>{c.about.operations}</p>
      <p class="claim">{qualityNote(lang)}</p>
    </div>
  </section>
  <section class="band-navy">
    <div class="wrap">
      <h2>{c.about.valuesTitle}</h2>
      <div class="grid-2">
        {
          c.about.values.map((v) => (
            <article class="card card-hover">
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section>
    <div class="wrap grid-2">
      <div>
        <h2>{c.about.whyTitle}</h2>
        <ul>
          {c.about.why.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h2>{c.about.specialtiesTitle}</h2>
        <p>{c.about.specialties}</p>
        <p>
          <a class="btn navy" href={localePath(lang, '/manufacturing')}>{c.cta.range}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
