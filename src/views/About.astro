---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import { t, type Locale } from '../lib/i18n';
import { localePath, asset } from '../lib/paths';

const valueIcons = ['lock', 'spark', 'user', 'cross'] as const;

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
---

<Base lang={lang} title={c.about.title} description={c.about.description} keywords={c.about.keywords} current="about">
  <section data-section={c.about.kicker}>
    <div class="wrap">
      <p class="kicker">{c.about.kicker}</p>
      <h1>{c.about.headline}</h1>
      <p class="lede">{c.about.overview}</p>
      <p>{c.about.operations}</p>
      <figure class="still">
        <img
          src={asset('/media/line-hall.jpg')}
          srcset={`${asset('/media/line-hall-sm.jpg')} 640w, ${asset('/media/line-hall.jpg')} 1280w`}
          sizes="(max-width: 760px) 100vw, 72rem"
          alt={c.about.stillAlt}
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>
  <section data-section={c.about.visionTitle}>
    <div class="wrap grid-2">
      <article class="card">
        <h2>{c.about.visionTitle}</h2>
        <p>{c.about.vision}</p>
      </article>
      <article class="card">
        <h2>{c.about.missionTitle}</h2>
        <p>{c.about.mission}</p>
      </article>
    </div>
  </section>
  <section data-section={c.about.roadmapTitle}>
    <div class="wrap">
      <h2>{c.about.roadmapTitle}</h2>
      <ol class="roadmap">
        {
          c.about.roadmap.map((step) => (
            <li>
              <p class="year">{step.year}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <Stats lang={lang} />
  <section class="band-navy" data-section={c.about.valuesTitle}>
    <div class="wrap">
      <h2>{c.about.valuesTitle}</h2>
      <div class="grid-2">
        {
          c.about.values.map((v, i) => (
            <article class="card card-hover">
              <span class="icon-tile on-navy">
                <Icon name={valueIcons[i]} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section data-section={c.about.whyTitle}>
    <div class="wrap grid-2">
      <div>
        <h2>{c.about.whyTitle}</h2>
        <ul>
          {c.about.why.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h2>{c.about.specialtiesTitle}</h2>
        <p>{c.about.specialties}</p>
        <p>
          <a class="btn navy" href={localePath(lang, '/manufacturing')}>{c.cta.range}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
