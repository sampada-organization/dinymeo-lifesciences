---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, type Locale } from '../lib/i18n';
import { productData, qualityNote } from '../lib/site';
import { localePath } from '../lib/paths';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
---

<Base
  lang={lang}
  title={c.manufacturing.title}
  description={c.manufacturing.description}
  current="manufacturing"
>
  <section>
    <div class="wrap">
      <p class="kicker">{c.manufacturing.kicker}</p>
      <h1>{c.manufacturing.headline}</h1>
      <p class="lede">{c.manufacturing.lead}</p>
      <p class="claim">{qualityNote(lang)}</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <h2>{c.manufacturing.productsTitle}</h2>
      <div class="grid-4">
        {
          productData.items.map((item) => (
            <article class="card" id={item.id}>
              <Icon name={item.icon} />
              <h3>{item[lang].name}</h3>
              <p>{item[lang].blurb}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="band-navy">
    <div class="wrap">
      <h2>{c.manufacturing.packTitle}</h2>
      <div class="grid-4">
        {
          productData.packaging.map((p) => (
            <article class="card">
              <Icon name="pack" />
              <h3>{p[lang]}</h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <h2>{c.manufacturing.processTitle}</h2>
      <ol class="process">
        {
          c.manufacturing.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p>
        <a class="btn navy" href={localePath(lang, '/contact')}>{c.cta.quote}</a>
      </p>
    </div>
  </section>
</Base>
