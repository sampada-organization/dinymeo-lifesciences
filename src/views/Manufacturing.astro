---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t, type Locale } from '../lib/i18n';
import { productData } from '../lib/site';
import { localePath, asset } from '../lib/paths';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
---

<Base
  lang={lang}
  title={c.manufacturing.title}
  description={c.manufacturing.description}
  current="manufacturing"
>
  <section data-section={c.manufacturing.kicker}>
    <div class="wrap">
      <p class="kicker">{c.manufacturing.kicker}</p>
      <h1>{c.manufacturing.headline}</h1>
      <p class="lede">{c.manufacturing.lead}</p>
    </div>
  </section>
  <section data-section={c.manufacturing.productsTitle}>
    <div class="wrap">
      <h2>{c.manufacturing.productsTitle}</h2>
      <div class="grid-4">
        {
          productData.items.map((item) => (
            <article class="card card-hover" id={item.id}>
              <span class="icon-tile">
                <Icon name={item.icon} />
              </span>
              <h3>{item[lang].name}</h3>
              <p>{item[lang].blurb}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="pack-band" data-section={c.manufacturing.packTitle}>
    <div class="wrap">
      <h2>{c.manufacturing.packTitle}</h2>
      <figure class="pack-hero">
        <img
          src={asset('/media/pack-hero.jpg')}
          srcset={`${asset('/media/pack-hero-sm.jpg')} 640w, ${asset('/media/pack-hero.jpg')} 1150w`}
          alt={c.manufacturing.packImageAlt}
          width="1150"
          height="665"
          sizes="(max-width: 760px) 100vw, min(72rem, 100vw)"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="pack-grid">
        {
          productData.packaging.map((p) => (
            <article class="card card-hover pack-card">
              <figure class="pack-shot">
                <img
                  src={asset(p.image)}
                  alt={p[lang].name}
                  width="954"
                  height="954"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <h3>{p[lang].name}</h3>
              <p>{p[lang].blurb}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section data-section={c.manufacturing.processTitle}>
    <div class="wrap">
      <h2>{c.manufacturing.processTitle}</h2>
      <ol class="process">
        {
          c.manufacturing.steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <p>
        <a class="btn navy" href={localePath(lang, '/contact')}>{c.cta.quote}</a>
      </p>
    </div>
  </section>
</Base>
