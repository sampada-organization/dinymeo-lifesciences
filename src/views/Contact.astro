---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { t, type Locale } from '../lib/i18n';
import { siteData, hours, mapsUrl, googleBusinessUrl, googleMapEmbedUrl, telUrl, mailUrl, whatsappUrl } from '../lib/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = t(lang);
---

<Base lang={lang} title={c.contact.title} description={c.contact.description} current="contact">
  <section data-section={c.contact.kicker}>
    <div class="wrap split-about">
      <div class="about-panel">
        <div>
        <p class="kicker">{c.contact.kicker}</p>
        <h1>{c.contact.headline}</h1>
        <p class="lede">{c.contact.lead}</p>
        <ul class="contact-list">
          <li>
            <span class="icon-tile"><Icon name="pin" /></span>
            <p>
              <strong>{c.contact.office}</strong><br />
              {siteData.address.lines.map((line) => <span>{line}<br /></span>)}
              <a href={mapsUrl()} target="_blank" rel="noopener noreferrer">{c.contact.map}</a>
            </p>
          </li>
          <li>
            <span class="icon-tile"><Icon name="phone" /></span>
            <p>
              <strong>{c.contact.phone}</strong><br />
              <a href={telUrl()}>{siteData.phone}</a>
            </p>
          </li>
          <li>
            <span class="icon-tile"><Icon name="wa" /></span>
            <p>
              <strong>{c.cta.whatsapp}</strong><br />
              <a href={whatsappUrl(c.cta.whatsappText)} target="_blank" rel="noopener noreferrer">{siteData.phone}</a>
            </p>
          </li>
          <li>
            <span class="icon-tile"><Icon name="mail" /></span>
            <p>
              <strong>{c.contact.email}</strong><br />
              <a href={mailUrl()}>{siteData.email}</a>
            </p>
          </li>
          <li>
            <span class="icon-tile"><Icon name="clock" /></span>
            <p>
              <strong>{c.contact.hours}</strong><br />
              {hours(lang)}
            </p>
          </li>
          <li>
            <span class="icon-tile"><Icon name="globe" /></span>
            <p>
              <strong>{c.contact.google}</strong><br />
              <a href={googleBusinessUrl()} target="_blank" rel="noopener noreferrer">{c.contact.google}</a>
            </p>
          </li>
        </ul>
        <div class="map-frame">
          <iframe
            title={c.contact.google}
            src={googleMapEmbedUrl()}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        </div>
      </div>
      <aside class="form-panel">
        <h2>{c.home.contactTitle}</h2>
        <p class="form-lead">{c.home.formLead}</p>
        <EnquiryForm lang={lang} compact />
      </aside>
    </div>
  </section>
</Base>
