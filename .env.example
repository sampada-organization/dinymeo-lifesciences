# Public site URL used in sitemap, canonical tags, and Open Graph.
PUBLIC_SITE_URL=https://dinymeo.com

# Leave empty for Azure Static Web Apps / custom domain (root).
# Set to /dinymeo-lifesciences/ only for GitHub project Pages without a domain.
ASTRO_BASE=/

# Local CMS password (admin at /admin). Override in Azure SWA app settings.
CMS_PASSWORD=dinymeo-dev

# Optional. If set, the enquiry API opens a GitHub issue instead of writing a local file.
GITHUB_REPO=sampada-organization/dinymeo-lifesciences
GITHUB_TOKEN=

# Optional. Azure Table / email later. Unused in v1.
ENQUIRY_NOTIFY_EMAIL=Dinymeo@gmail.com
